    @if (data.Data.Page.Media == null)
    {
        <div>Lade Daten...</div>
    }
    else
    {
        foreach (var anime in data.Data.Page.Media)
        {
            <h1>@anime.Title.English</h1>
            <img src="@anime.CoverImage.ExtraLarge"/>
        }
    }

</div>

@if (_hasReachedBottom)
{
    <p>Du bist ganz unten angekommen.</p>
}

<div @ref="_bottomElement" style="height: 1px;"></div>

@code {

    private LoadFrontPageResponse data;
    private int test1 = 1;
    private int test2 = 5;
    
    
    protected override async Task OnInitializedAsync()
    {
        data = await ApiClient.DashboardAsync(test1, test2);
        
    }

    
    
    
    private ElementReference _bottomElement;
    private DotNetObjectReference<Home>? _dotNetRef;
    private bool _hasReachedBottom;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dotNetRef = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "scrollBottomTracker.start",
            _bottomElement,
            _dotNetRef
        );
    }

    [JSInvokable]
    public Task ReachedBottom()
    {
        _hasReachedBottom = true;
        StateHasChanged();

        test1 += 5;
        test2 += 5;
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("scrollBottomTracker.stop");
        _dotNetRef?.Dispose();
    }
}
