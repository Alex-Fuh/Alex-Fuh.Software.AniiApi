@page "/"
@inject IJSRuntime JS
@inject IAniiApiClient ApiClient
@implements IAsyncDisposable

<h1>Home</h1>

<div>

    
    @if (data.Data.Page.Media == null)
    {
        <div>Lade Daten...</div>
    }
    else
    {
        foreach (var anime in data.Data.Page.Media)
        {
            <h1>@(anime.Title?.English ?? anime.Title?.Romaji ?? "Kein Titel")</h1>
            @if (anime.CoverImage?.ExtraLarge != null)
            {
                <img src="@anime.CoverImage.ExtraLarge"/>
            }
        }
    }

</div>


<div @ref="_bottomElement" style="height: 1px;"></div>

@code {
    
    private LoadFrontPageResponse data;
    private LoadFrontPageResponse newData;
    private int page = 1;
    private int perPage = 5;
    
    
    protected override async Task OnInitializedAsync()
    {
        data = await ApiClient.DashboardAsync(page, perPage);
    }

    
    
    
// Referenz auf das <div @ref="_bottomElement"> im Razor-Template
    private ElementReference _bottomElement;
// Verpackt "this" damit JS die Komponente aufrufen kann
    private DotNetObjectReference<Home>? _dotNetRef;
    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dotNetRef = DotNetObjectReference.Create(this);

        // Ersten Observer starten
        await StartTracking();
    }

// Ausgelagert als eigene Methode, damit sie mehrfach aufrufbar ist
    private async Task StartTracking()
    {
        await JS.InvokeVoidAsync(
            "scrollBottomTracker.start",
            _bottomElement,
            _dotNetRef
        );
    }

    [JSInvokable]
    public async Task ReachedBottom()
    {

        page += 1;

        newData = await ApiClient.DashboardAsync(page, perPage);
        data.Data.Page.Media = data.Data.Page.Media.Concat(newData.Data.Page.Media).ToList();
 
        StateHasChanged();

        // Warten bis Blazor das DOM wirklich aktualisiert hat,
        // erst dann hat _bottomElement seine neue Position
        await Task.Yield();

        // Observer neu starten — trackt jetzt wieder das Ende der längeren Liste
        await StartTracking();
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("scrollBottomTracker.stop");
        _dotNetRef?.Dispose();
    }
}
