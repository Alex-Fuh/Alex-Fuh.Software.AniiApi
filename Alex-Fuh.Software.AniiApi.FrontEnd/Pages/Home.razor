@page "/"
@inject IJSRuntime JS
@inject IAniiApiClient ApiClient
@implements IAsyncDisposable

<div class="title-card-container">

    
    @if (currentLoadedTitles == null)
    {
        for (int i = 0; i < perPage; i++)
        {
        <div class="title-card">
            <div class="title-card-skelleton">
                <div class="skelleton-image"></div>
                <div class="skelleton-title-line"></div>
                <div class="skelleton-title-line skelleton-title-line--short"></div>
            </div>
        </div>
        }
    }
    else
    {
            
        foreach (var currentTitle in currentLoadedTitles.Data.Page.Media)
        {
            <div class="title-card">
                @if (currentTitle.CoverImage?.ExtraLarge != null)
                {
                    <img class="title-image" src="@currentTitle.CoverImage.ExtraLarge"/>
                }
                <p class="title">@(currentTitle.Title?.Romaji ?? currentTitle.Title?.English ?? "Kein Titel")</p>
            </div>
        }
            if (isLoading)
            {
                for (int i = 0; i < perPage; i++)
                {
                    <div class="title-card">
                        <div class="title-card-skelleton">
                            <div class="skelleton-image"></div>
                            <div class="skelleton-title-line"></div>
                            <div class="skelleton-title-line skelleton-title-line--short"></div>
                        </div>
                    </div>
                }
            }
    }

</div>


<div @ref="_bottomElement" style="height: 1px;"></div>

@code {
    
    private LoadFrontPageResponse currentLoadedTitles;
    private LoadFrontPageResponse newTitleResponse;
    private int page = 1;
    private int perPage = 20;
    private bool isLoading = false;
    
    
    protected override async Task OnInitializedAsync()
    {
        currentLoadedTitles = await ApiClient.DashboardAsync(page, perPage);
    }

    
    
    
// Referenz auf das <div @ref="_bottomElement"> im Razor-Template
    private ElementReference _bottomElement;
// Verpackt "this" damit JS die Komponente aufrufen kann
    private DotNetObjectReference<Home>? _dotNetRef;
    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dotNetRef = DotNetObjectReference.Create(this);

        // Ersten Observer starten
        await StartTracking();
    }

// Ausgelagert als eigene Methode, damit sie mehrfach aufrufbar ist
    private async Task StartTracking()
    {
        await JS.InvokeVoidAsync(
            "scrollBottomTracker.start",
            _bottomElement,
            _dotNetRef
        );
    }

    [JSInvokable]
    public async Task ReachedBottom()
    {
        isLoading = true;
        StateHasChanged();
        page += 1;

        newTitleResponse = await ApiClient.DashboardAsync(page, perPage);
        currentLoadedTitles.Data.Page.Media = currentLoadedTitles.Data.Page.Media.Concat(newTitleResponse.Data.Page.Media).ToList();
        isLoading = false;
        StateHasChanged();

        // Warten bis Blazor das DOM wirklich aktualisiert hat,
        // erst dann hat _bottomElement seine neue Position
        await Task.Yield();

        // Observer neu starten — trackt jetzt wieder das Ende der längeren Liste
        await StartTracking();
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("scrollBottomTracker.stop");
        _dotNetRef?.Dispose();
    }
}
